# ─── Identidade do agente ────────────────────────────────────────────────────
IPNET_AGENT_NAME=IPNET WhatsApp Agent
IPNET_INSTANCE_NAME=ipnet-whatsapp-agent

# ─── LLM (Gemini) ────────────────────────────────────────────────────────────
IPNET_GEMINI_API_KEY=SUA_GEMINI_API_KEY_AQUI
IPNET_GEMINI_MODEL=gemini-2.5-flash
IPNET_GEMINI_TEMPERATURE=0.7
IPNET_GEMINI_MAX_TOKENS=2048

# ─── WhatsApp / Evolution API ────────────────────────────────────────────────
IPNET_EVOLUTION_API_URL=https://evolution.seudominio.com
IPNET_EVOLUTION_API_KEY=SUA_EVOLUTION_API_KEY_AQUI

# ─── Banco e cache ───────────────────────────────────────────────────────────
# Desenvolvimento local:
# IPNET_POSTGRES_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/agentdb
# IPNET_REDIS_URL=redis://127.0.0.1:6379/0
#
# Cloud Run:
# - Cloud SQL com Auth Proxy continua em 127.0.0.1
# - Redis do Memorystore usa IP privado da VPC
IPNET_POSTGRES_URL=postgresql+asyncpg://agentuser:SENHA@127.0.0.1:5432/agentdb
IPNET_REDIS_URL=redis://10.x.x.x:6379/0

# ─── Runtime do agente ───────────────────────────────────────────────────────
IPNET_DEBOUNCE_SECONDS=5
IPNET_MAX_HISTORY_MESSAGES=20
IPNET_SESSION_TTL_SECONDS=3600
IPNET_WEBHOOK_SECRET=
IPNET_HOST=0.0.0.0
IPNET_PORT=8080

# ─── Deploy no GCP ───────────────────────────────────────────────────────────
# Se a Service Account ja existe, preencha o e-mail dela aqui.
IPNET_SERVICE_ACCOUNT=sua-sa@SEU_PROJECT_ID.iam.gserviceaccount.com
